# status: design-doc — This file is a legacy Vite-era artifact.
# The plugin now runs as a DSH Cordis plugin and does NOT use Vite env vars.
# LLM configuration is handled by DSH's own provider/profile system.
# Kept for historical reference only.

# Legacy LLM config (no longer used)
# VITE_LLM_API_KEY=your-deepseek-or-openai-api-key
# VITE_LLM_BASE_URL=https://api.deepseek.com/v1
# VITE_LLM_MODEL=deepseek-chat

# Legacy workspace path (now set via config.workspace in index.ts apply())
# VITE_WORKSPACE=./workspace
