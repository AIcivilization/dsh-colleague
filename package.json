{
  "name": "colleague-plugin",
  "version": "0.1.0",
  "description": "有记忆、有角色的长期 AI 团队 — 基于 DeepSeek Harness 的多 agent 协作插件",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.yml",
    "templates",
    "skills",
    "config"
  ],
  "scripts": {
    "build": "tsc --noEmit false && tsdown",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "npm run type-check && npm run test && npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-subagent": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-tool-subagent": ">=0.1.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-tool-subagent": {
      "optional": false
    }
  },
  "dependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsdown": "^0.12.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
