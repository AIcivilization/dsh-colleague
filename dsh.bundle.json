{
  "id": "dsh-colleague",
  "name": "dsh-colleague",
  "version": "0.1.0",
  "description": "Persistent, role-based AI teams — a multi-agent collaboration plugin for DeepSeek Harness",
  "author": "AIcivilization",
  "license": "MIT",
  "homepage": "https://github.com/AIcivilization/dsh-colleague#readme",
  "entry": {
    "host": "./dist/index.js",
    "client": "./dist/web/main.js"
  },
  "inject": [],
  "optionalInject": ["dsh-subagent"],
  "provides": ["colleague-team"],
  "config": {
    "schema": {
      "configPath": {
        "type": "string",
        "default": "config/team.yaml",
        "description": "Team configuration file path"
      },
      "maxConcurrentWriters": {
        "type": "number",
        "default": 1,
        "description": "Maximum concurrent write tasks (first version fixed at 1, serial writes)"
      },
      "memoryEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable memory injection"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.8",
    "@deepseek-ai/dsh": ">=0.1.0-rc.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
