{
  "id": "colleague-plugin",
  "name": "colleague-plugin",
  "version": "0.1.0",
  "description": "有记忆、有角色的长期 AI 团队 — 基于 DeepSeek Harness 的多 Agent 协作插件",
  "author": "Colleague Plugin Team",
  "license": "MIT",
  "homepage": "file:///Users/wf/自进化/临时/colleague-plugin",
  "entry": {
    "host": "./dist/index.js",
    "client": "./dist/web/main.js"
  },
  "inject": [],
  "optionalInject": ["dsh-subagent"],
  "provides": ["colleague-team"],
  "config": {
    "schema": {
      "configPath": {
        "type": "string",
        "default": "config/team.yaml",
        "description": "团队配置文件路径"
      },
      "maxConcurrentWriters": {
        "type": "number",
        "default": 1,
        "description": "最大并发写任务数（首版固定为 1，串行写入）"
      },
      "memoryEnabled": {
        "type": "boolean",
        "default": true,
        "description": "是否启用记忆注入"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.8",
    "@deepseek-ai/dsh": ">=0.1.0-rc.8"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
